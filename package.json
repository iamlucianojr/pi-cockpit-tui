{
	"name": "pi-cockpit-tui",
	"version": "0.1.2",
	"description": "Terminal UI for pi: footers with git status, task tracking, tool counters, subagent widgets and theme cycling in one hot-reloadable extension.",
	"type": "module",
	"keywords": [
		"pi-package",
		"pi",
		"pi-extension",
		"tui",
		"footer",
		"statusline",
		"tasks",
		"git"
	],
	"homepage": "https://github.com/iamlucianojr/pi-cockpit-tui#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/iamlucianojr/pi-cockpit-tui.git"
	},
	"bugs": {
		"url": "https://github.com/iamlucianojr/pi-cockpit-tui/issues"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"typecheck": "tsc --noEmit",
		"test": "node --test 'test/*.test.ts'",
		"prepublishOnly": "npm run typecheck && npm test"
	},
	"engines": {
		"node": ">=22.6"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": ">=0.84",
		"@earendil-works/pi-ai": ">=0.84",
		"@earendil-works/pi-tui": ">=0.84",
		"@sinclair/typebox": ">=0.34"
	},
	"devDependencies": {
		"typescript": "^5.9.3"
	},
	"license": "MIT",
	"author": "Luciano Goncalves",
	"files": [
		"CHANGELOG.md",
		"LICENSE",
		"README.md",
		"package.json",
		"src"
	]
}
